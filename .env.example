# 复制为 .env 后填入真实值。.env 已在 .gitignore 中。

# 阿里云百炼（DashScope）OpenAI 兼容端点
DASHSCOPE_API_KEY=sk-xxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# B站创作者接口有 IP 风控，建议运行 scripts/login_bili.py 登录。
BILI_COOKIE=

# GPU 服务器（供 tools/remote.py 使用）
VSPIDER_SSH_HOST=
VSPIDER_SSH_PORT=22
VSPIDER_SSH_USER=root
VSPIDER_SSH_PASSWORD=
