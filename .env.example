# 复制为 .env 后填入真实值。.env 已在 .gitignore 中。

# 阿里云百炼（DashScope）OpenAI 兼容端点
DASHSCOPE_API_KEY=sk-xxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 平台登录态。全部可选，不填则走匿名访问。
#
# B 站创作者投稿接口带 IP 级风控，匿名访问单次成功率只有 0%~50%
# （见 docs/EXPERIMENTS.md E6），代码里靠退避重试兜底。
# 填入浏览器登录后的完整 Cookie（至少含 SESSDATA）可显著稳定，
# 取法：登录 bilibili.com，开发者工具 Network 里任取一个请求复制 Cookie 请求头。
BILI_COOKIE=

# GPU 服务器（供 tools/remote.py 使用）
VSPIDER_SSH_HOST=
VSPIDER_SSH_PORT=22
VSPIDER_SSH_USER=root
VSPIDER_SSH_PASSWORD=
